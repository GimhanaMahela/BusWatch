# TransitX mobile app. Copy to .env and fill in. EXPO_PUBLIC_ values are built into the app.

# The TransitX API, including /api. On a phone, localhost is the phone itself: use your computer's
# LAN address (http://192.168.1.20:5000/api) or the Android emulator's alias (http://10.0.2.2:5000/api).
# Staging and production builds set this in eas.json / EAS environment variables.
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# Public website, used for links the app shares (tracking pages)
EXPO_PUBLIC_WEB_URL=http://localhost:3000
