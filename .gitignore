# Applies to the whole repo (api, ui and mobile apps).
# mobile/.gitignore adds Expo's own rules (.expo/, generated android/ and ios/ folders).

# Dependencies
node_modules/

# Environment variables (keep the committed templates)
.env
.env.*
!.env.example

# Build output
build/
dist/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local file uploads
uploads/

# IDE / editor
.vscode/
.idea/
.refact/

# Vercel
.vercel/

# OS
.DS_Store
Thumbs.db

# Next.js
.next/
next-env.d.ts
*.tsbuildinfo

# Mobile app (Expo / EAS): build outputs and signing secrets
*.apk
*.aab
*.ipa
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
credentials.json
google-service-account*.json

# Private notes with credentials; never commit
docs/Creds.odt

# Mobile: temporary folders from moving node_modules aside (npm run relock)
.mobile_nm_tmp/
.node_modules.relock/
