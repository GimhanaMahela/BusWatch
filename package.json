{
  "name": "buswatch",
  "version": "2.0.0",
  "private": true,
  "description": "BusWatch: report and track public transport incidents (API + Next.js web UI)",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,magenta \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "npm run db:migrate && tsx watch --env-file-if-exists=.env api/src/server.ts",
    "dev:ui": "next dev ui --port 3000",
    "build": "npm run build:api && npm run build:ui",
    "build:api": "tsc -p api/tsconfig.build.json",
    "build:ui": "next build ui",
    "start": "node --env-file-if-exists=.env api/dist/server.js",
    "start:ui": "next start ui --port 3000",
    "db:generate": "drizzle-kit generate --config api/drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env api/src/db/migrate.ts",
    "db:studio": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio --config api/drizzle.config.ts",
    "typecheck": "next typegen ui && tsc -p tsconfig.json && tsc -p api --noEmit && tsc -p ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:api": "vitest run --project api",
    "test:ui": "vitest run --project ui",
    "test:watch": "vitest",
    "vercel-build": "npm run db:migrate && npm run build:ui"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@mui/utils": "^9.5.0",
    "@mui/x-charts": "^9.17.0",
    "@mui/x-data-grid": "^9.17.0",
    "@next/eslint-plugin-next": "^16.4.6",
    "@react-google-maps/api": "^2.20.8",
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "axios": "^1.21.1",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "next": "^16.4.6",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "license": "ISC"
}
