# Stage 1: Build the React application
FROM node:20-alpine AS build-stage

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# CRA bakes env vars in at build time, so the API URL is a build argument.
# It must be reachable from the user's browser (not the Docker network name).
ARG REACT_APP_BACKEND_URL=http://localhost:5000/api
ARG REACT_APP_Maps_API_KEY=
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
ENV REACT_APP_Maps_API_KEY=$REACT_APP_Maps_API_KEY

# Build the React app for production
# This creates the optimized static assets in the 'build' folder
RUN npm run build

# Stage 2: Serve the React application with a lightweight Nginx server
FROM nginx:alpine AS production-stage

# Copy the built React app from the build-stage to Nginx's serving directory
COPY --from=build-stage /app/build /usr/share/nginx/html

# SPA routing: send unknown paths to index.html so React Router can handle them
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose the port Nginx listens on
EXPOSE 80

# Command to run Nginx (default command for nginx:alpine is fine)
CMD ["nginx", "-g", "daemon off;"]