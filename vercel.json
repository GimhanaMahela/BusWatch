{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/src/server.ts", "use": "@vercel/node" },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "ui/dist" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/src/server.ts" },
    { "src": "/health", "dest": "/api/src/server.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
