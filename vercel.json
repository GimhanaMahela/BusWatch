{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/src/server.ts",
      "use": "@vercel/node",
      "config": { "includeFiles": ["api/assets/**"] }
    },
    { "src": "ui/next.config.ts", "use": "@vercel/next" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/src/server.ts" },
    { "src": "/health", "dest": "/api/src/server.ts" }
  ]
}
