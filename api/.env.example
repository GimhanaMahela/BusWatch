# Copy to .env and fill in

PORT=5000
MONGO_URI=mongodb://localhost:27017/buswatchdb

# Required: long random string used to sign admin tokens
JWT_SECRET=

# First superadmin, created only when the database has no admins (password: 8+ chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated frontend URLs allowed by CORS (leave empty to allow all in development)
CORS_ORIGINS=http://localhost:3000

# Public URL of the frontend, used for "track your report" links in emails
FRONTEND_URL=http://localhost:3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (emails are skipped when host/user are empty)
EMAIL_SERVICE_HOST=
EMAIL_SERVICE_PORT=587
EMAIL_SERVICE_USER=
EMAIL_SERVICE_PASS=
# Set to true only for test SMTP servers with self-signed certificates (e.g. Ethereal)
EMAIL_ALLOW_SELF_SIGNED=false
