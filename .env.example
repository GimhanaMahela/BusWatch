# BusWatch configuration for both apps. Copy to .env and fill in.
# The API reads every variable; the UI (Next.js) only exposes variables prefixed with NEXT_PUBLIC_ to the browser.

# ---------------------------------------------------------------- API
PORT=5000
# PostgreSQL connection string. The default matches `docker compose up -d postgres` (host port 5440).
# For a local install use port 5432; for hosted Postgres (Neon, Supabase, RDS) add ?sslmode=require
DATABASE_URL=postgres://buswatch:buswatch@localhost:5440/buswatch

# Required: long random string used to sign admin tokens
JWT_SECRET=

# First superadmin, created only when the database has no admins (password: 8+ chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public URL of the UI, used for "track your report" / "rate the outcome" links in emails and for
# absolute share-preview image URLs (Open Graph)
FRONTEND_URL=http://localhost:3000

# Only needed when the UI is served from a different origin than the API
# (comma-separated). Same-origin setups (dev proxy, Docker, Vercel) can leave it empty.
CORS_ORIGINS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (emails are skipped when host/user are empty)
EMAIL_SERVICE_HOST=
EMAIL_SERVICE_PORT=587
EMAIL_SERVICE_USER=
EMAIL_SERVICE_PASS=
# Set to true only for test SMTP servers with self-signed certificates (e.g. Ethereal)
EMAIL_ALLOW_SELF_SIGNED=false

# ---------------------------------------------------------------- UI
# Where the Next server forwards /api. Defaults to http://localhost:$PORT; Docker sets http://api:5000.
API_UPSTREAM=

# Exposed to the browser (baked in at build time)
# Leave empty to call the API on the same origin at /api (recommended); Next forwards /api to the API.
NEXT_PUBLIC_API_URL=

# Google Maps API key for the location picker (optional).
# Enable "Maps JavaScript API" and restrict the key to your domain.
NEXT_PUBLIC_MAPS_API_KEY=
