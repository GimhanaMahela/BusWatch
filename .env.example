# BusWatch configuration for both apps. Copy to .env and fill in.
# The API reads every variable; the UI (Vite) only sees variables prefixed with VITE_.

# ---------------------------------------------------------------- API
PORT=5000
MONGO_URI=mongodb://localhost:27017/buswatchdb

# Required: long random string used to sign admin tokens
JWT_SECRET=

# First superadmin, created only when the database has no admins (password: 8+ chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public URL of the UI, used for "track your report" links in emails
FRONTEND_URL=http://localhost:3000

# Only needed when the UI is served from a different origin than the API
# (comma-separated). Same-origin setups (dev proxy, Docker, Vercel) can leave it empty.
CORS_ORIGINS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (emails are skipped when host/user are empty)
EMAIL_SERVICE_HOST=
EMAIL_SERVICE_PORT=587
EMAIL_SERVICE_USER=
EMAIL_SERVICE_PASS=
# Set to true only for test SMTP servers with self-signed certificates (e.g. Ethereal)
EMAIL_ALLOW_SELF_SIGNED=false

# ---------------------------------------------------------------- UI (exposed to the browser)
# Leave empty to call the API on the same origin at /api (recommended).
VITE_BACKEND_URL=

# Google Maps API key for the location picker (optional).
# Enable "Maps JavaScript API" and restrict the key to your domain.
VITE_MAPS_API_KEY=
