# TransitX configuration for both apps. Copy to .env and fill in.
# The API reads every variable; the UI (Next.js) only exposes variables prefixed with NEXT_PUBLIC_ to the browser.

# ---------------------------------------------------------------- API
PORT=5000
# PostgreSQL connection string. The default matches `docker compose up -d postgres` (host port 5440).
# For a local install use port 5432. Hosted databases are encrypted automatically (see DATABASE_SSL).
#
# Supabase (Project → Connect): use the "Transaction pooler" string (port 6543) here, and the
# "Session pooler" (port 5432) or "Direct connection" string in DATABASE_DIRECT_URL for migrations.
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   DATABASE_DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F).
DATABASE_URL=postgres://buswatch:buswatch@localhost:5440/buswatch
# Used by `npm run db:migrate` when set (otherwise DATABASE_URL)
DATABASE_DIRECT_URL=
# auto (default): TLS for every host except localhost and docker-compose's "postgres"; on / off force it
DATABASE_SSL=auto
# Optional: the database's CA certificate (PEM, "\n" for line breaks), to verify the server too.
# Supabase: Project Settings → Database → SSL Configuration → Download certificate
DATABASE_CA_CERT=

# Required: long random string used to sign admin tokens
JWT_SECRET=

# First superadmin, created only when the database has no admins (password: 8+ chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public URL of the UI, used for "track your report" / "rate the outcome" links in emails and for
# absolute share-preview image URLs (Open Graph)
FRONTEND_URL=http://localhost:3000

# Only needed when the UI is served from a different origin than the API
# (comma-separated). Same-origin setups (dev proxy, Docker, Vercel) can leave it empty.
CORS_ORIGINS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare Turnstile (CAPTCHA) for public report submissions. Leave both empty to disable
# (development). Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# SMS (or WhatsApp) updates and "My reports" sign-in codes for passengers who give a mobile number.
# SMS_PROVIDER: none (default; in development texts are printed to the console), android (free),
# notifylk or twilio. With none, the forms hide the phone field and My reports asks for email only
# (except in development, where texts and codes are printed to the console).
SMS_PROVIDER=none
# android: texts go out from your own Android phone and SIM (only your normal SMS package costs).
# Install "SMS Gateway for Android" (https://sms-gate.app) and copy the username/password it shows.
# Cloud mode (default URL) works anywhere; for local mode use http://<phone-ip>:8080 on the same Wi-Fi.
ANDROID_SMS_URL=
ANDROID_SMS_USERNAME=
ANDROID_SMS_PASSWORD=
# Notify.lk (Sri Lanka): https://app.notify.lk/settings/api-keys. Use sender ID NotifyDEMO to test.
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=
# Twilio: TWILIO_FROM is your Twilio number (+1...) for SMS, or "whatsapp:+1..." for WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Browser push notifications. Generate the pair once with `npx web-push generate-vapid-keys`
# (changing it later stops existing subscriptions). Subject: mailto: or https: contact for push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Free Telegram updates: message @BotFather on Telegram, send /newbot and paste the token here.
# Works on localhost (the API asks Telegram for new messages). Once hosted, you can set a secret
# (letters, digits, _ or -) so Telegram calls FRONTEND_URL/api/telegram/webhook instead; required
# on serverless hosts such as Vercel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# AI help for admins (optional): category suggestions, English translations, summaries, and blurring
# faces and number plates in photos before bus operators see them. Uses Google Gemini's free tier:
# get a free key (no card needed) at https://aistudio.google.com/apikey. The AI panel is hidden when
# the key is empty. On the free tier Google may use what is sent to improve its products.
GEMINI_API_KEY=
# AI_MODEL=gemini-flash-latest
# Tried when AI_MODEL is busy ("high demand") or out of free quota
# AI_FALLBACK_MODEL=gemini-flash-lite-latest
# The same key runs the TransitX helper chat on the public site (answers questions and fills in the
# report form). It shares the free quota with the admin AI help; "false" hides it.
AI_CHAT_ENABLED=true
# "true" analyses every new report as soon as it arrives (otherwise admins click Analyse)
AI_AUTO_ANALYSE=false

# The TransitX WhatsApp bot (optional), on Meta's WhatsApp Cloud API: passengers report (with photos,
# voice notes and location), track and follow reports by chatting. Needs GEMINI_API_KEY for the
# chat; without it the bot only tracks reports. Set-up steps are in the README.
# From Meta's app dashboard > WhatsApp > API Setup: a permanent access token and the phone number ID
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings > Basic > App secret (every webhook call is signed with it)
WHATSAPP_APP_SECRET=
# Any string you choose; enter the same one when registering FRONTEND_URL/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
# The bot's number as passengers see it, for the site's "Chat on WhatsApp" buttons (+94771234567)
WHATSAPP_DISPLAY_NUMBER=
# Optional: an approved template for updates sent more than 24 hours after the passenger last wrote
# (WhatsApp allows only templates then). Body with {{1}} = receipt ID and {{2}} = the update.
WHATSAPP_UPDATE_TEMPLATE=
# WHATSAPP_API_VERSION=v23.0

# SMTP for receipts, status updates and sign-in codes (skipped when host/user are empty). Supabase's
# built-in email only sends Supabase Auth emails, so use an SMTP provider. Check with
# `npm run email:test -- you@example.com`. Examples:
#   Brevo (300/day free): smtp-relay.brevo.com, 587, your Brevo login, an SMTP key
#   Resend:               smtp.resend.com, 465, user "resend", an API key
#   Gmail:                smtp.gmail.com, 587, your address, an app password (2-step verification on)
EMAIL_SERVICE_HOST=
EMAIL_SERVICE_PORT=587
EMAIL_SERVICE_USER=
EMAIL_SERVICE_PASS=
# Sender, e.g. TransitX <noreply@your-domain.lk> (a domain or address verified with the provider).
# Defaults to the user name, which must then be an email address
EMAIL_FROM=
# Implicit TLS; defaults to true on port 465, STARTTLS otherwise
EMAIL_SERVICE_SECURE=
# Set to true only for test SMTP servers with self-signed certificates (e.g. Ethereal)
EMAIL_ALLOW_SELF_SIGNED=false

# ---------------------------------------------------------------- UI
# Where the Next server forwards /api. Defaults to http://localhost:$PORT; Docker sets http://api:5000.
API_UPSTREAM=

# Exposed to the browser (baked in at build time)
# Site colours and style: transitx (the TransitX logo's navy, blue and orange; the default), sunset
# (Lanka Sunset, crimson to saffron), aurora (Midnight Aurora, indigo and violet), emerald (Emerald
# Trust, greens and gold) or classic (the original blue and violet).
# Restart `npm run dev` or rebuild after changing it.
NEXT_PUBLIC_THEME=transitx

# Leave empty to call the API on the same origin at /api (recommended); Next forwards /api to the API.
NEXT_PUBLIC_API_URL=

# Google Maps API key for the location picker (optional).
# Enable "Maps JavaScript API" and restrict the key to your domain.
NEXT_PUBLIC_MAPS_API_KEY=

# Turnstile site key (public half of TURNSTILE_SECRET_KEY above)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
